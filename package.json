  "scripts": {
    "dev": "next dev",
    "prebuild": "if [ -L node_modules/node_modules ]; then rm -f node_modules/node_modules; fi",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "backup:postgres": "bash scripts/backup-postgres.sh",
    "backup:offsite": "bash scripts/backup-offsite.sh",
    "restore:postgres": "bash scripts/restore-postgres.sh",
    "restore:drill": "bash scripts/restore-drill.sh",
    "watchdog": "bash scripts/atcell-watchdog.sh",
    "smoke:deployment": "node scripts/smoke-deployment.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.8.0",
