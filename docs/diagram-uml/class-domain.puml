@startuml
' --- gaya At Cell (inline, mandiri utk server publik) ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName sans-serif
skinparam defaultFontSize 13
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam headerFontSize 11
skinparam footerFontSize 11
skinparam noteBackgroundColor #FFF8DC
skinparam noteBorderColor #B89B00
skinparam actorBackgroundColor #E8EEF7
skinparam actorBorderColor #0B4ED8
skinparam participantBackgroundColor #E8EEF7
skinparam participantBorderColor #0B4ED8
skinparam usecaseBackgroundColor #E8EEF7
skinparam usecaseBorderColor #0B4ED8
skinparam classBackgroundColor #E8EEF7
skinparam classBorderColor #0B4ED8
skinparam objectBackgroundColor #EEF3FA
skinparam objectBorderColor #0B4ED8
skinparam activityBackgroundColor #E8EEF7
skinparam activityBorderColor #0B4ED8
skinparam activityDiamondBackgroundColor #FFFFFF
skinparam activityDiamondBorderColor #0B4ED8
skinparam stateBackgroundColor #E8EEF7
skinparam stateBorderColor #0B4ED8
skinparam stateStartColor #0B4ED8
skinparam stateEndColor #0B4ED8
skinparam componentBackgroundColor #E8EEF7
skinparam componentBorderColor #0B4ED8
skinparam cloudBackgroundColor #F2F5FA
skinparam cloudBorderColor #5B6B82
skinparam databaseBackgroundColor #E8EEF7
skinparam databaseBorderColor #0B4ED8
skinparam entityBackgroundColor #E8EEF7
skinparam entityBorderColor #0B4ED8
