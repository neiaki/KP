@startuml
' --- gaya At Cell (inline, mandiri utk server publik) ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName sans-serif
skinparam defaultFontSize 13
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam headerFontSize 11
skinparam footerFontSize 11
skinparam noteBackgroundColor #FFF8DC
skinparam noteBorderColor #B89B00
skinparam actorBackgroundColor #E8EEF7
skinparam actorBorderColor #0B4ED8
skinparam participantBackgroundColor #E8EEF7
skinparam participantBorderColor #0B4ED8
skinparam usecaseBackgroundColor #E8EEF7
skinparam usecaseBorderColor #0B4ED8
skinparam classBackgroundColor #E8EEF7
skinparam classBorderColor #0B4ED8
skinparam objectBackgroundColor #EEF3FA
skinparam objectBorderColor #0B4ED8
skinparam activityBackgroundColor #E8EEF7
skinparam activityBorderColor #0B4ED8
skinparam activityDiamondBackgroundColor #FFFFFF
skinparam activityDiamondBorderColor #0B4ED8
skinparam stateBackgroundColor #E8EEF7
skinparam stateBorderColor #0B4ED8
skinparam stateStartColor #0B4ED8
skinparam stateEndColor #0B4ED8
skinparam componentBackgroundColor #E8EEF7
skinparam componentBorderColor #0B4ED8
skinparam cloudBackgroundColor #F2F5FA
skinparam cloudBorderColor #5B6B82
skinparam databaseBackgroundColor #E8EEF7
skinparam databaseBorderColor #0B4ED8
skinparam entityBackgroundColor #E8EEF7
skinparam entityBorderColor #0B4ED8
skinparam sequenceArrowColor #334155
skinparam sequenceLifeLineBorderColor #0B4ED8
skinparam sequenceParticipantBorderColor #0B4ED8
footer Dipelihara di docs/diagram-uml, render dari sumber .puml
title Use Case sisi portal staf
actor Sales as S
actor Teknisi as T
actor Admin as A
rectangle "At Cell Web - Portal" {
  rectangle "Kasir dan inventaris" {
    usecase "Masuk dan Dibuka ke Kasir" as MasukKasir
    usecase "Jual Lewat Kasir" as JualKasir
    usecase "Validasi IMEI Available" as ValidasiIMEI
    usecase "Proses Tukar Tambah" as TukarTambah
    usecase "Daftarkan Unit Batch IMEI" as DaftarBatch
    usecase "Pantau Status Unit" as PantauUnit
    usecase "Kelola Etalase & Harga" as KelolaEtalase
    usecase "Kelola Akun Pelanggan" as KelolaPelanggan
    usecase "Pantau Antrean Servis" as PantauServis
  }
  rectangle "Meja servis" {
    usecase "Masuk dan Dibuka ke Meja Servis" as MasukServis
    usecase "Buat Tiket Servis" as BuatTiket
    usecase "Update Workflow dan Biaya" as UpdateTiket
    usecase "Catat Serah Terima Unit" as SerahTerima
  }
  rectangle "Kelola toko" {
    usecase "Masuk dan Dibuka ke Dashboard" as MasukDash
    usecase "Lihat Dashboard Bisnis" as LihatDash
    usecase "Kelola Master Produk" as KelolaProduk
    usecase "Kelola Akun Staf" as KelolaStaf
    usecase "Kelola Pengaturan Toko" as KelolaToko
    usecase "Lihat Laporan Performa" as LihatLaporan
    usecase "Pakai Semua Menu Operasional" as PakaiSemua
  }
}
S --> MasukKasir
S --> JualKasir
S --> TukarTambah
S --> DaftarBatch
S --> PantauUnit
S --> KelolaEtalase
S --> KelolaPelanggan
S --> BuatTiket
S --> PantauServis
T --> MasukServis
T --> BuatTiket
T --> UpdateTiket
T --> SerahTerima
A --> MasukDash
A --> LihatDash
A --> KelolaProduk
A --> KelolaStaf
A --> KelolaToko
A --> LihatLaporan
A --> PantauUnit
A --> PakaiSemua
JualKasir ..> ValidasiIMEI : <<include>>
TukarTambah ..> JualKasir : <<extend>>
PakaiSemua ..> PantauUnit : <<include>>
caption Detail batasan tiap aktor ada di diagram use case per aktor
@enduml
