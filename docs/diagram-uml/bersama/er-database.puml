@startuml
' --- gaya At Cell (inline, mandiri utk server publik) ---
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName sans-serif
skinparam defaultFontSize 13
skinparam titleFontSize 18
skinparam titleFontStyle bold
skinparam headerFontSize 11
skinparam footerFontSize 11
skinparam noteBackgroundColor #FFF8DC
skinparam noteBorderColor #B89B00
skinparam actorBackgroundColor #E8EEF7
skinparam actorBorderColor #0B4ED8
skinparam participantBackgroundColor #E8EEF7
skinparam participantBorderColor #0B4ED8
skinparam usecaseBackgroundColor #E8EEF7
skinparam usecaseBorderColor #0B4ED8
skinparam classBackgroundColor #E8EEF7
skinparam classBorderColor #0B4ED8
skinparam objectBackgroundColor #EEF3FA
skinparam objectBorderColor #0B4ED8
skinparam activityBackgroundColor #E8EEF7
skinparam activityBorderColor #0B4ED8
skinparam activityDiamondBackgroundColor #FFFFFF
skinparam activityDiamondBorderColor #0B4ED8
skinparam stateBackgroundColor #E8EEF7
skinparam stateBorderColor #0B4ED8
skinparam stateStartColor #0B4ED8
skinparam stateEndColor #0B4ED8
skinparam componentBackgroundColor #E8EEF7
skinparam componentBorderColor #0B4ED8
skinparam cloudBackgroundColor #F2F5FA
skinparam cloudBorderColor #5B6B82
skinparam databaseBackgroundColor #E8EEF7
skinparam databaseBorderColor #0B4ED8
skinparam entityBackgroundColor #E8EEF7
skinparam entityBorderColor #0B4ED8
skinparam sequenceArrowColor #334155
skinparam sequenceLifeLineBorderColor #0B4ED8
skinparam sequenceParticipantBorderColor #0B4ED8
footer Dipelihara di docs/diagram-uml, render dari sumber .puml
title Skema database At Cell
entity "profiles" as profiles {
  * id : uuid <<PK, FK auth.users>>
  --
  * full_name : text
  * role : user_role
  * phone_number : text
}
entity "store_settings" as settings {
  * id : int <<PK, selalu 1>>
  --
  * store_name : text
  * description_id : text
  * description_en : text
  * address : text
  * phone_number : text
  * opening_hours : jsonb
}
entity "products" as products {
  * id : bigint <<PK>>
  --
  * brand : text
  * model_name : text
  * default_price : numeric
  * image_url : text
}
entity "inventory_units" as units {
  * id : bigint <<PK>>
  --
  o product_id : bigint <<FK, null untuk tukar tambah>>
  o imei : text <<UNIQUE, 15 digit atau null untuk demo>>
  * condition : new | second
  * status : unit_status
  * purchase_cost : numeric
  * selling_price : numeric
}
entity "transactions" as tx {
  * id : bigint <<PK>>
  --
  o invoice_number : text <<UNIQUE>>
  o sales_id : uuid <<FK>>
  o customer_id : uuid <<FK>>
  * customer_name : text
  * final_payment : numeric
  * payment_method : enum
}
entity "transaction_items" as items {
  * id : bigint <<PK>>
  --
  * transaction_id : bigint <<FK>>
  * unit_id : bigint <<FK>>
  * unit_price : numeric
  * warranty_duration_months : int
}
entity "trade_in_records" as tradein {
  * id : bigint <<PK>>
  --
  o transaction_id : bigint <<FK>>
  o resulting_unit_id : bigint <<FK>>
  * original_brand_model : text
  * imei : text <<15 digit>>
  * grading_details : jsonb
  * offered_price : numeric
}
entity "service_tickets" as tickets {
  * id : bigint <<PK>>
  --
  * ticket_code : text <<UNIQUE>>
  o customer_id : uuid <<FK>>
  o technician_id : uuid <<FK>>
  * device_model : text
  * repair_status : enum
  * sparepart_fee : numeric
  * labor_fee : numeric
  * total_fee : numeric
}
entity "v_public_inventory" as etalase <<view>> {
  merek, model, kondisi, harga jual
}
entity "product_images" as gambar {
  * id : bigint <<PK>>
  --
  o product_id : bigint <<FK, null aset web>>
  * path : text <<UNIQUE>>
  * kind : official | second | hero | payment
}
entity "unit_status_audit" as auditunit {
  * id : bigint <<PK>>
  --
  * unit_id : bigint <<FK>>
  * old_status : enum <<null SQL manual>>
  * new_status : enum
  o actor_id : uuid <<FK, null SQL manual>>
}
entity "service_ticket_audit" as audittiket {
  * id : bigint <<PK>>
  --
  * ticket_id : bigint <<FK>>
  * old_status : enum <<null SQL manual>>
  * new_status : enum
  o actor_id : uuid <<FK, null SQL manual>>
}

products ||--o{ units : punya
tx ||--o{ items : dirinci
units ||--o{ items : terjual
tx |o--o| tradein : dipotong
tradein o--o| units : unit lama masuk stok
profiles |o--o{ tx : mencatat dan membeli
profiles |o--o{ tickets : menangani
products }o--o{ etalase : dibaca server
units }o--o{ etalase : hanya available
products ||--o{ gambar : didaftar
units ||--o{ auditunit : dicatat
tickets ||--o{ audittiket : dicatat
profiles |o--o{ auditunit : pelaku
profiles |o--o{ audittiket : pelaku
note bottom of tickets
  Pemicu BEFORE INSERT menerbitkan ticket_code atomik.
  Pemicu BEFORE UPDATE OF status menolak perubahan status dari sold.
  View etalase dibaca server lewat koneksi database langsung; anon tidak punya grant.
  Audit mencatat who, what, when tiap mutasi status.
end note
@enduml
