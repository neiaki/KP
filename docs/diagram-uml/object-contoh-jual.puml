@startuml
title Potret satu penjualan dengan tukar tambah
object "p : Produk" as p {
  brand = Apel
  model_name = iPhone 13
}
object "uBaru : Unit" as uBaru {
  imei = 990000000000001
  condition = new
  status = sold
}
