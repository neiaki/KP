title Kerjakan tiket servis sampai selesai
start
partition Teknisi {
:Buka tiket di meja servis;
:Isi status berikut, biaya, catatan, foto bukti;
:Ajukan update;
}
partition Sistem {
if (Peran admin atau technician?) then (tidak)
  :Tolak update;
  stop
else (ya)
endif
if (Transisi status diizinkan?) then (tidak)
  :Tolak update;
  stop
else (ya)
endif
}
partition Basis Data {
:Simpan status, biaya, rincian, foto;
:Hitung total sama dengan sparepart plus jasa;
}
partition Teknisi {
if (Status sudah completed?) then (ya)
  :Centang konfirmasi nota servis;
  :Ubah status completed ke picked_up;
  :Catat waktu serah terima;
  stop
else (tidak)
endif
if (Perlu uji ulang?) then (ya)
  :Kembali isi status berikut;
else (tidak)
  :Tutup hari, lanjut tiket lain;
  stop
endif
}
note right
  cancelled boleh dari tahap mana pun sebelum completed.
  completed tidak bisa dibatalkan, hanya bisa diserahterimakan.
  Serah terima hanya admin dan teknisi; sales hanya mencatat tiket masuk.
  Rincian biaya maks 50 baris, foto maks 10 berkas.
end note
@enduml
