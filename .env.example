# Salin ke .env.local dan isi nilainya. Jangan commit .env.local.
GOOGLE_PLACES_API_KEY=

# --- Backend Supabase At Cell (wajib agar portal live; kosongkan = mode demo mock) ---
# 1. Buat project baru di https://supabase.com/dashboard (JANGAN pakai project
#    Portfolio/PKM yang sudah ada di ~/.secrets).
# 2. SQL Editor > paste supabase/migrations/0001_atcell_schema.sql > Run.
# 3. Project Settings > Data API > salin URL + anon public key ke bawah ini.
# 4. Buat user awal (Authentication > Users), lalu set perannya:
#    Tabel Editor > profiles > ubah role user tersebut menjadi 'admin'.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hanya untuk server (JANGAN beri prefix NEXT_PUBLIC):
# Project Settings > API Keys > service_role (untuk tracking publik + invite staf).
SUPABASE_SERVICE_ROLE_KEY=

# --- Drizzle ORM (koneksi Postgres langsung, melewati RLS) ---
# Supabase Dashboard > Project Settings > Database > Connection String
# (pilih mode "Transaction pooling", ganti [YOUR-PASSWORD]).
# Dipakai drizzle-kit (migrate/studio) dan Server Action via src/db/client.ts.
# Penegakan peran tetap di requireRole() tiap action karena koneksi ini
# tidak tunduk pada RLS. Contoh:
# DATABASE_URL="postgresql://postgres.xxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
DATABASE_URL=
