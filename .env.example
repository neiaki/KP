# Salin ke .env.local dan isi nilainya. Jangan commit .env.local.
GOOGLE_PLACES_API_KEY=

# --- Backend Supabase At Cell (wajib agar portal live; kosongkan hanya untuk demo lokal) ---
# 1. Buat project baru di https://supabase.com/dashboard (JANGAN pakai project
#    Portfolio/PKM yang sudah ada di ~/.secrets).
# 2. SQL Editor > paste supabase/migrations/0001_atcell_schema.sql > Run.
# 3. Project Settings > API Keys > salin URL + publishable key ke bawah ini.
#    (ANON_KEY tetap diterima untuk kompatibilitas project lama.)
# 4. Buat user awal (Authentication > Users), lalu set perannya:
#    Tabel Editor > profiles > ubah role user tersebut menjadi 'admin'.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hanya untuk server (JANGAN beri prefix NEXT_PUBLIC):
# Project Settings > API Keys > secret key (atau service_role untuk project lama).
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Domain cookie Supabase untuk sesi lintas subdomain produksi.
# Contoh: .atcell.my.id (kosongkan di local development).
SUPABASE_COOKIE_DOMAIN=

# Origin tambahan untuk Next Server Actions jika ada fallback/domain lain.
# Pisahkan dengan koma, tanpa protocol/path.
SERVER_ACTIONS_ALLOWED_ORIGINS=

# --- Drizzle ORM (koneksi Postgres langsung, melewati RLS) ---
# Supabase Dashboard > Project Settings > Database > Connection String
# (pilih mode "Transaction pooling", ganti [YOUR-PASSWORD]).
# Dipakai drizzle-kit (migrate/studio) dan Server Action via src/db/client.ts.
# Penegakan peran tetap di requireRole() tiap action karena koneksi ini
# tidak tunduk pada RLS. Contoh:
# DATABASE_URL="postgresql://postgres.xxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
DATABASE_URL=
