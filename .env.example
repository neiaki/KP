# Salin ke .env.local dan isi nilainya. Jangan commit .env.local.

# --- Google Places (ulasan toko) ---
# Tanpa key ini, reviews.ts mengembalikan null dan beranda menampilkan ajakan
# menulis ulasan, bukan rating angka karangan. Place ID hanya dipakai kalau
# key tersedia; tanpa key seluruh blok API dilewati.
GOOGLE_PLACES_API_KEY=
# Opsional. Kosongkan untuk memakai Place ID bawaan At Cell.
GOOGLE_PLACE_ID=

# --- Backend Supabase At Cell (wajib agar portal live; kosongkan hanya untuk demo lokal) ---
# 1. Buat project baru di https://supabase.com/dashboard (JANGAN pakai project
#    Portfolio/PKM yang sudah ada di ~/.secrets).
# 2. SQL Editor > paste supabase/migrations/0001_atcell_schema.sql > Run.
# 3. Project Settings > API Keys > salin URL + publishable key ke bawah ini.
#    (ANON_KEY tetap diterima untuk kompatibilitas project lama.)
# 4. Buat user awal (Authentication > Users), lalu set perannya:
#    Tabel Editor > profiles > ubah role user tersebut menjadi 'admin'.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hanya untuk server (JANGAN beri prefix NEXT_PUBLIC):
# Project Settings > API Keys > secret key (atau service_role untuk project lama).
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Domain cookie Supabase untuk sesi lintas subdomain produksi.
# Contoh: .atcell.my.id (kosongkan di local development).
SUPABASE_COOKIE_DOMAIN=

# Origin tambahan untuk Next Server Actions jika ada fallback/domain lain.
# Pisahkan dengan koma, tanpa protocol/path.
SERVER_ACTIONS_ALLOWED_ORIGINS=

# --- Drizzle ORM (koneksi Postgres langsung, melewati RLS) ---
# Supabase Dashboard > Project Settings > Database > Connection String
# (pilih mode "Transaction pooling", ganti [YOUR-PASSWORD]).
# Dipakai drizzle-kit (migrate/studio) dan Server Action via src/db/client.ts.
# Penegakan peran tetap di requireRole() tiap action karena koneksi ini
# tidak tunduk pada RLS. Contoh:
# DATABASE_URL="postgresql://postgres.xxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"
DATABASE_URL=

# --- Batas waktu satu query lewat koneksi Drizzle ---
# Milidetik, hanya bilangan bulat positif yang dipakai. Kosong, nol, atau
# bukan angka akan diabaikan driver postgres dan batas waktunya hilang
# tanpa galat sama sekali, jadi kode memakai bawaan 8000 dan memangkas
# nilai di atas 30000 ke 30000. Naikkan hanya kalau query etalase di
# produksi sering terpotong; di Vercel `max` cuma 1 koneksi, jadi nilai
# besar menahan seluruh instance. Kosongkan untuk memakai bawaan.
STATEMENT_TIMEOUT_MS=

# --- Sentry (pelacakan galat production, opsional) ---
# Kosongkan DSN untuk mematikan Sentry sepenuhnya. Sentry.init() tidak
# dijalankan sama sekali tanpa DSN, jadi tidak ada request keluar dan tidak
# ada biaya. Endpoint /api/health/ready tidak bergantung Sentry: isinya hanya
# memeriksa Supabase, database, dan secret server, supaya Sentry yang salah
# konfigurasi tidak ikut membuat Coolify menandai container unhealthy.
#
# Apa yang TIDAK pernah dikirim ke Sentry, apa pun nilai DSN di bawah ini:
# - Rekam layar (session replay). Mati total, termasuk saat ada galat. Replay
#   adalah perekam DOM di browser, jadi isinya tidak bisa disaring dari sisi
#   server, dan halaman portal menampilkan nama, telepon, IMEI, kode tiket,
#   serta nomor nota pelanggan. Galatnya tetap terkirim, hanya rekamannya
#   yang tidak ada. Jangan menaikkan replaysOnErrorSampleRate tanpa alasan.
# - Query string URL, termasuk ?ticket=SRV-... pada halaman lacak publik.
# - IP pengunjung (event.user.ip_address) dan header x-forwarded-for.
# - Body request, cookie, serta header Authorization/Cookie.
# Yang tetap dikirim: pesan galat, stack trace, nama route, dan header
# non-kredensial seperti user-agent. Semua itu diatur di src/instrumentation.ts
# dan src/instrumentation-client.ts, bukan lewat environment variable.
#
# DSN BUKAN rahasia: nilainya berakhir di dalam HTML yang dikirim ke browser,
# itu memang cara kerja Sentry. Yang berbahaya adalah DSN yang dipasangkan
# dengan Auth Token, jadi prefix NEXT_PUBLIC_ di sini disengaja.
# Ambil dari sentry.io > Settings > Projects > Client Keys > DSN.
NEXT_PUBLIC_SENTRY_DSN=

# Sisi server: Server Actions, Route Handlers, dan komponen server. Kosongkan
# kalau hanya ingin menangkap galat di browser saja.
SENTRY_DSN=

# Versi aplikasi yang dilaporkan ke Sentry, format atcell-web@<commit-sha>.
# Dikosongkan kalau belum diisi; Sentry tetap melapor, hanya nomor versinya
# belum-known sehingga error dari beberapa deploy tercampur jadi satu grup.
NEXT_PUBLIC_COMMIT_SHA=

# Auth token untuk unggah sourcemap lewat sentry-cli. Hanya dipakai di server
# dan tidak dibaca aplikasi saat runtime. Jangan pernah di NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=

# --- Backup off-site (scripts/backup-offsite.sh) ---
# Tanpa passphrase, script keluar 0 tanpa mengirim apa pun, jadi cron harian
# aman dipasang sebelum tujuan dikonfigurasi. Isi salah satu tujuan
# (rclone atau PUT) untuk mengaktifkan kiriman sungguhan.
# Passphrase untuk enkripsi AES-256. Lebih aman lewat file 0600.
OFFSITE_PASSPHRASE=
OFFSITE_PASSPHRASE_FILE=
# Tujuan rclone (misalnya "r2:atcell-backup"). Butuh `rclone config` sekali
# di VPS; script tidak pernah memegang access key.
OFFSITE_RCLONE_REMOTE=
# Alternatif: HTTP PUT dengan bearer token untuk endpoint kustom.
OFFSITE_PUT_URL=
OFFSITE_PUT_TOKEN=
OFFSITE_PUT_TOKEN_FILE=
# Direktori staging berkas terenkripsi dan jumlah yang disimpan lokal.
OFFSITE_STAGING_DIR=
OFFSITE_KEEP_ENCRYPTED=

# Sidik jari sertifikat penandatangan APK At Cell, untuk
# /.well-known/assetlinks.json.
#
# Android membandingkan nilai ini dengan sertifikat yang benar-benar
# menandatangani my.id.atcell. Kalau cocok, app dianggap pembungkus sah dari
# atcell.my.id, address bar tidak muncul, dan Play Protect melihat app yang
# terverifikasi. Kalau kosong atau salah, app tetap jalan tapi ditandai tidak
# terverifikasi, yang justru memicu peringatan.
#
# Format: 64 karakter heksadesimal tanpa titik dua. Beberapa sidik jari boleh
# dipisah spasi atau koma; dipakai untuk publikasi lewat Play App Signing,
# di mana sidik jari app signing Google berbeda dari upload key.
#
# Ambil dari keystore yang dipakai build:
#   keytool -list -v -keystore atcell-release.jks -storepass <password>
# lalu salin baris SHA256 dan buang tanda titik duanya.
#
# BUKAN rahasia: sidik jari sertifikat memang publik, ada di dalam APK mana
# pun, jadi nilainya tidak pernah di-redact.
#
# SENGAJA tanpa prefix NEXT_PUBLIC_. Prefix itu berarti "ini boleh dibaca
# browser", dan Next.js meng-inline nilainya ke bundle begitu variabelnya ada
# saat `next build`. Route /.well-known/assetlinks.json memakai force-dynamic
# supaya sidik jari baru berlaku tanpa build ulang, jadi nilainya harus dibaca
# dari env container saat runtime. Pakai prefix NEXT_PUBLIC_ di sini membuat
# nilai lama membeku diam-diam begitu variabelnya ikut terbawa ke build.
ANDROID_APP_SHA256=
