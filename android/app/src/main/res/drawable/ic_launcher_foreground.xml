<?xml version="1.0" encoding="utf-8"?>
<!--
    Foreground launcher icon: kotak putih membulat berisi "AT".

    Adaptive icon berukuran 108x108dp, dan area aman yang tidak pernah
    dipotong adalah 72x72dp di tengah, yaitu 18 sampai 90. Bentuk di bawah
    berada di 30 sampai 78, jadi selalu di dalam area aman untuk lingkaran,
    squircle, maupun rounded square.

    Persentase tidak bisa dipakai di sini: atribut inset dan radius pada
    drawable Android hanya menerima satuan absolut, bukan persen. Karena itu
    bentuknya digambar sebagai path di dalam viewport 108x108.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M42,30 h24 a12,12 0 0 1 12,12 v24 a12,12 0 0 1 -12,12 h-24 a12,12 0 0 1 -12,-12 v-24 a12,12 0 0 1 12,-12 z" />
</vector>
