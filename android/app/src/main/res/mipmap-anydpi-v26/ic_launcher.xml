<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher icon adaptif.

    Background biru aksen penuh, foreground kotak putih berisi "AT" yang
    digambar sebagai drawable terpisah. Kombinasi dua warna ini yang sama
    dengan icon maskable di web (src/app/icon.tsx), jadi launcher dan PWA
    terlihat sama.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
